<header class="container-fluid py-2">
  <div class="d-flex flex-wrap align-items-center justify-content-between px-3 w-100">
    <a class="logo-header" href="index.html">
      <img src="img/logo-coldhielo-optimizado.png" alt="Cold Hielo Logo" width="1024" height="1024" decoding="async">
    </a>

    <div class="d-flex align-items-end pt-4">
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-controls="main-menu" aria-expanded="false">
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </button>

      <nav id="main-menu" class="main-nav" aria-label="Navegación principal">
        <ul class="nav">
          {{#each navigation}}
            <li class="nav-item">
              <a class="nav-links{{#if (isCurrent id ../page.id)}} active{{/if}}" href="{{href}}"{{#if (isCurrent id ../page.id)}} aria-current="page"{{/if}}>{{label}}</a>
            </li>
          {{/each}}
        </ul>
      </nav>
    </div>
  </div>
</header>
