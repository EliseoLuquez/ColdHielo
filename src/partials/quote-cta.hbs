<section class="site-quote-cta" aria-labelledby="site-quote-title">
  <div class="site-quote-cta__inner">
    <div class="site-quote-cta__copy">
      <h2 id="site-quote-title">Solicitá tu presupuesto</h2>
      {{#if (isCurrent page.id "productos")}}
        <p>Contanos qué tipo de hielo necesitás, la cantidad, la fecha y la zona de entrega.</p>
      {{else}}
        {{#if (isCurrent page.id "contacto")}}
          <p>Contanos qué necesitás, para qué fecha y en qué zona. Te responderemos con disponibilidad y opciones.</p>
        {{else}}
          <p>Contanos qué equipo necesitás, para qué fecha y en qué zona. Te responderemos con disponibilidad y opciones.</p>
        {{/if}}
      {{/if}}
    </div>
    <a href="{{{page.whatsappUrl}}}" target="_blank" rel="noopener noreferrer" class="site-quote-cta__button" aria-label="Pedir presupuesto por WhatsApp">
      Pedir presupuesto por WhatsApp
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>
