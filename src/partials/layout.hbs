<!doctype html>
<html lang="es">
  {{> head}}
  <body class="page-{{page.id}}">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <div class="hero">
      {{> header}}
      {{> @partial-block}}
      {{> quote-cta}}
      {{> whatsapp}}
      {{> footer}}
      <nav class="bottom-mobile-nav" aria-label="Navegación rápida">
          {{#each navigation}}
            <a href="{{href}}"{{#if (isCurrent id ../page.id)}} class="active" aria-current="page"{{/if}}>
              <img src="img/nav/{{mobileIcon}}.png" alt="" width="96" height="96" aria-hidden="true">
              <span>{{label}}</span>
            </a>
          {{/each}}
      </nav>
    </div>
    <script type="module" src="./src/scripts/main.js"></script>
  </body>
</html>
